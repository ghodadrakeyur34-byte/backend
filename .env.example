# ======================================================
# MARI MILKAT EMAIL CONFIGURATION (.env)
# ======================================================

# Option 1: Resend HTTPS API (RECOMMENDED for Render & Cloud Hosts — Port 443, 100% reliable)
# Free 3,000 emails/month from https://resend.com (No SMTP blocking)
# RESEND_API_KEY=re_123456789...
# RESEND_FROM=Mari Milkat <onboarding@resend.dev>

# Option 2: Brevo (Sendinblue) HTTPS API (Free 300 emails/day — Port 443)
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM=marimilkat@gmail.com

# Option 3: Gmail SMTP (Local development & hosts with open SMTP ports)
# GMAIL_USER=marimilkat@gmail.com
# GMAIL_PASS=your16digitapppassword

# Option 4: Custom SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=yourpassword
# SMTP_FROM="Mari Milkat" <noreply@marimilkat.com>

# Google Sign-In OAuth 2.0 Client ID
# Create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


